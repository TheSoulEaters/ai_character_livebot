# .env

# API Key untuk OpenAI (ChatGPT)
OPENAI_API_KEY=your_openai_api_key

# ID Video YouTube Live (untuk mengambil komentar)
YOUTUBE_VIDEO_ID=your_youtube_video_id

# Text-to-Speech (TTS) Configuration
USE_TTS=True                     # Mengaktifkan atau menonaktifkan TTS
TTS_ENGINE=pyttsx3                # Pilih engine TTS: 'pyttsx3', 'gTTS', 'ElevenLabs'
TTS_LANGUAGE=en                   # Bahasa TTS (misalnya: 'en' untuk Inggris, 'id' untuk Indonesia)
TTS_VOICE=male                    # Jenis suara TTS: 'male' atau 'female'
TTS_RATE=150                       # Kecepatan suara (lebih tinggi = lebih cepat)

# Ekspresi Karakter 2D
DEFAULT_CHARACTER_EXPRESSION=neutral  # Ekspresi default karakter: 'neutral', 'happy', 'angry', 'sad'
SPEAKING_EXPRESSION=speaking        # Ekspresi saat karakter sedang berbicara
EMOTIONAL_THRESHOLD=0.6             # Batas ambang deteksi emosi (misalnya: 0.6 untuk respons emosional)

# Pengaturan OBS / Stream Control (Jika menggunakan OBS atau VTube Studio)
USE_STREAM_CONTROL=True            # Aktifkan kendali OBS/VTube Studio
OBS_WEBSOCKET_HOST=localhost       # Host OBS WebSocket
OBS_WEBSOCKET_PORT=4444            # Port OBS WebSocket
OBS_PASSWORD=                      # Password OBS WebSocket (jika ada)

# Memory Management (Opsional, untuk menyimpan percakapan)
USE_MEMORY=True                    # Mengaktifkan atau menonaktifkan penyimpanan memori
MEMORY_FILE_PATH=memory/user_sessions.json  # Lokasi file memori
MEMORY_RECALL_LIMIT=5              # Batas berapa banyak pesan yang diingat

# Logging
LOG_LEVEL=INFO                     # Level log: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_FILE_PATH=logs/errors.log      # Lokasi file log error

# Notifikasi (Opsional)
ENABLE_NOTIFICATIONS=False         # Aktifkan atau nonaktifkan notifikasi (misalnya, email atau SMS)
NOTIFICATION_EMAIL=your_email@example.com # Email untuk notifikasi
NOTIFICATION_API_KEY=your_api_key  # API Key untuk layanan notifikasi (misalnya Twilio, SendGrid)

# Other Settings
DEBUG_MODE=False                   # Aktifkan mode debug untuk pengembangan
